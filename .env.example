# HEL.ink hub: hel.ink (home) + hub.hel.ink (HOP ID). Copy to .env and fill in.
APP_NAME=HOP
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://hub.hel.ink
# The two hosts this app answers on (Route::domain). Dev and tests: leave both "localhost".
HUB_HOST=hub.hel.ink
HUB_PUBLIC_HOST=hel.ink
HUB_PUBLIC_URL=https://hel.ink
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=en
# Cloudflare in front: "cloudflare" trusts Cloudflare's ranges for the visitor IP.
TRUSTED_PROXIES=cloudflare

# The owner. SUPERADMIN_EMAIL keeps working until `php artisan hop:owner you@hel.ink` has run.
SUPERADMIN_EMAIL=
ADMIN_EMAIL=admin@hel.ink
SUPPORT_EMAIL=support@hel.ink
SECURITY_EMAIL=security@hel.ink
FEEDBACK_EMAIL=feedback@hel.ink

# One database shared with LinkHop and BioHop. The hub keeps its migration log in migrations_hub.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=helink
DB_USERNAME=helink
DB_PASSWORD=
DB_MIGRATIONS_TABLE=migrations_hub

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE=hub_session
SESSION_DOMAIN=hub.hel.ink
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
LOG_CHANNEL=daily
LOG_LEVEL=warning

# SSO: the same 32+ character secret in every app's .env (HOP_SSO_SECRET), or one per app.
HOP_SSO_SECRET=
#HOP_SSO_SECRET_LINKHOP=
#HOP_SSO_SECRET_BIOHOP=
#HOP_SSO_SECRET_PIXELHOP=
# The apps (config/hop.php). Empty URL or ENABLED=false hides an app everywhere.
LINKHOP_URL=https://link.hel.ink
LINKHOP_ENABLED=true
#LINKHOP_CHECK_URL=https://hel.ink/l/health-check
BIOHOP_URL=https://bio.hel.ink
BIOHOP_ENABLED=true
#BIOHOP_CHECK_URL=https://hel.ink/b/health-check
PIXELHOP_URL=https://pixel.hel.ink
PIXELHOP_ENABLED=true
PIXELHOP_SSO_CALLBACK=/auth/helink/callback
PIXELHOP_SSO_START=/auth/helink
#PIXELHOP_LOGOUT_PATH=/auth/helink/logout

# Watchdog alerts (hop:watch, every minute via the scheduler) after 3 failures in a row.
WATCH_ALERT_EMAIL=admin@hel.ink
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google sign-in. Redirect URI in Google Cloud: https://hub.hel.ink/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile (one widget, hostnames hel.ink, hub.hel.ink, link.hel.ink, bio.hel.ink). Empty: no challenge.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Mail from the @hel.ink address (SMTP of the mailbox provider).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@hel.ink
MAIL_FROM_NAME="HOP"

# Optional: GeoIP and proxy detection for the login history (all free tiers).
IPINFO_API_KEY=
PROXYCHECK_API_KEY=
GEOLITE_ACCOUNT_ID=
GEOLITE_LICENSE_KEY=
# Optional: Google Safe Browsing for hop/safety.
SAFE_BROWSING_KEY=
